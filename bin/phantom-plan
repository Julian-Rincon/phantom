#!/usr/bin/env python3
"""Pregunta al router de Phantom cómo repartiría un trabajo, sin delegar nada.

    phantom-plan plan:hard "diseñar la migración" implement:long "migrar los 40 módulos" test:normal

Cada tarea es `tipo:dificultad`, seguida opcionalmente de una etiqueta entre comillas.
Tipos: plan implement refactor debug review test explore research shell docs quick
Dificultades: trivial normal hard long
`--json` devuelve la respuesta cruda. El router decide con la cuota de Claude, el perfil
activo y lo que ha aprendido de delegaciones anteriores; para delegar de verdad se usa
`delegate_to_agent(agent_type="auto", task_kind=..., difficulty=...)` dentro de Phantom."""
import json
import os
import sys
import urllib.error
import urllib.request

ENV = os.path.expanduser("~/.config/codeg/server.env")


def entorno() -> dict:
    out = {}
    try:
        for linea in open(ENV, encoding="utf-8"):
            clave, sep, valor = linea.strip().partition("=")
            if sep and not clave.startswith("#"):
                out[clave] = valor.strip().strip('"').strip("'")
    except OSError:
        pass
    return out


def main(argv: list[str]) -> int:
    crudo = "--json" in argv
    argv = [a for a in argv if a != "--json"]
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0 if argv else 2
    tareas = []
    for a in argv:
        tipo, sep, dif = a.partition(":")
        if sep and " " not in a and tipo.isalpha() and dif.isalpha():
            tareas.append({"label": "", "task_kind": tipo, "difficulty": dif})
        elif tareas and not tareas[-1]["label"]:
            tareas[-1]["label"] = a
        else:
            print(f"No entiendo «{a}»: se espera tipo:dificultad y luego, si acaso, una etiqueta.", file=sys.stderr)
            return 2
    env = entorno()
    host = env.get("CODEG_HOST") or "127.0.0.1"
    host = "127.0.0.1" if host in ("0.0.0.0", "::") else host
    url = f"http://{host}:{env.get('CODEG_PORT') or '3080'}/api/phantom_route_plan"
    req = urllib.request.Request(url, data=json.dumps({"tasks": tareas}).encode(), method="POST",
                                 headers={"content-type": "application/json",
                                          "authorization": f"Bearer {env.get('CODEG_TOKEN', '')}"})
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            plan = json.load(r)
    except urllib.error.HTTPError as e:
        print(f"Phantom respondió {e.code}. ¿Es una versión sin /api/phantom_route_plan?", file=sys.stderr)
        return 1
    except OSError as e:
        print(f"No pude hablar con Phantom en {url}: {e}", file=sys.stderr)
        return 1
    if crudo:
        print(json.dumps(plan, ensure_ascii=False, indent=2))
        return 0
    for t in plan:
        nombre = t["label"] or f"{t['task_kind']} {t['difficulty']}"
        if t.get("error"):
            print(f"✗ {nombre}: {t['error']}")
            continue
        print(f"• {nombre}  [{t['task_kind']}/{t['difficulty']}]")
        print(f"    {t['agent_type']} · {t.get('model') or 'modelo por defecto'} · esfuerzo {t.get('effort') or '—'}")
        if t.get("reason"):
            print(f"    {t['reason']}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
