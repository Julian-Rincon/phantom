# Phantom — environment template
#
# Copy this file to build either:
#   1) the local server config: ~/.config/codeg/server.env (chmod 600), or
#   2) a .env next to docker-compose.yml for the isolated Docker/Podman sandbox.
#
# Never commit a copy of this file with real values filled in.

# Required. Bearer token every HTTP/WebSocket request to codeg-server must
# present (Authorization: Bearer <token>). There is no default — the server
# fails closed (401) if this is empty, so it must be generated per install:
#   openssl rand -hex 32
CODEG_TOKEN=

# Interface the server binds. Keep 127.0.0.1 for a local install so the
# service is loopback-only. The Docker sandbox overrides this to 0.0.0.0
# internally (see docker-compose.yml) and instead limits exposure by only
# publishing the container's port to 127.0.0.1 on the host.
CODEG_HOST=127.0.0.1

# HTTP/WebSocket port for the UI and API.
CODEG_PORT=3080

# Port bridge used to expose dev servers started by agents through the
# workbench. Kept off for this deployment: no additional ports are opened.
CODEG_BRIDGE_PORTS=off

# Where Codeg stores its database, imported history index and uploads.
# Local install default: ~/.local/share/codeg
# Docker sandbox: /data (see the named volume in docker-compose.yml)
CODEG_DATA_DIR=

# Where the built Next.js static export is served from.
# Local install default: ~/.local/share/codeg/web
# Docker sandbox: /app/web (baked into the image, do not override)
CODEG_STATIC_DIR=

# Path to the codeg-mcp binary (the stdio MCP delegation broker injected per
# agent session). Leave unset to use the default exe-sibling lookup next to
# codeg-server; only set this if the binaries are not installed side by side.
CODEG_MCP_BIN=

# Log verbosity: error | warn | info | debug | trace
CODEG_LOG=info

# Optional. Default model preselected for new sessions, if the install should
# not start from the app's own default. Left commented out on purpose.
# CODEG_DEFAULT_MODEL=
